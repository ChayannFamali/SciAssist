# SciAssist — скопируй в .env и подставь пути СВОЕЙ машины.
# Репо общий (git); этот файл в .gitignore.

# ── Выбор роутера моделей ─────────────────────────────────────────────
# НОУТБУК (Linux, CPU): раскомментируй — грузит configs/model_router.laptop.yaml
# ПК (Windows, CUDA): оставь закомментированным — живёт configs/model_router.yaml
# Роль, отсутствующая в yaml машины, валит пайплайн на select(...) — оба yaml полные.
SCIASSIST_MODEL_ROUTER=configs/model_router.laptop.yaml

# ── Zotero (локально, БЕЗ api.zotero.org) ────────────────────────────
# Ноут: ~/Zotero | ПК: D:/libraries — подставь своё
ZOTERO_DATA_DIR=/home/USER/Zotero
ZOTERO_STORAGE_DIR=/home/USER/Zotero/storage
ZOTERO_LOCAL_URL=http://127.0.0.1:23119
# Ключ local API (write): после «Always Allow» в диалоге Zotero
ZOTERO_LOCAL_API_KEY=

# ── Obsidian ──────────────────────────────────────────────────────────
OBSIDIAN_VAULT=/mnt/newdisk/SciVault
OBSIDIAN_PAPERS_FOLDER=papers
OBSIDIAN_CONCEPTS_FOLDER=concepts
OBSIDIAN_DATASETS_FOLDER=datasets

# ── LM Studio ────────────────────────────────────────────────────────
LM_STUDIO_URL=http://localhost:1234/v1
# Ноут (CPU, тайминги от замеров): reasoning 900 / fast 240
# ПК (GPU): можно меньше, напр. 300 / 60
LM_STUDIO_TIMEOUT_REASONING=900
LM_STUDIO_TIMEOUT_FAST=240

# ── Пути проекта (PROJECT_ROOT — корень репо) ────────────────────────
# Относительные от PROJECT_ROOT работают; полные — тоже.
# Ноут-пример:
PROJECT_ROOT=/mnt/newdisk/SciAssist
CHROMA_DB_PATH=/mnt/newdisk/SciAssist/data/chroma_db
LOGS_PATH=/mnt/newdisk/SciAssist/data/logs
RAW_MARKDOWN_PATH=/mnt/newdisk/SciAssist/data/raw_markdown
EXTRACTED_FIGURES_PATH=/mnt/newdisk/SciAssist/data/extracted_figures
REGISTRY_PATH=/mnt/newdisk/SciAssist/data/processed_registry.json
# ПК-пример: PROJECT_ROOT=H:/SciAssist и т.д.
